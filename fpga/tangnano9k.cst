// Pin map for soc_tangnano9k on the Tang Nano 9K (Gowin GW1NR-9, QN88).
// Clock, reset button, LEDs and the UART pin are the standard Tang Nano 9K
// assignments from Sipeed's examples. The screen pins further down are NOT
// verified -- see the note there. Used by: nextpnr --cst fpga/tangnano9k.cst

// ---- 27 MHz on-board oscillator --------------------------------------------
IO_LOC  "clk_in" 52;
IO_PORT "clk_in" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- reset button S1 (active low: idles high, pressed pulls to ground) ------
IO_LOC  "btn_rst_n" 4;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- UART TX -> on-board USB-serial bridge (appears as a COM port on your PC)
IO_LOC  "uart_tx_pin" 17;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 DRIVE=8;

// ---- 6 on-board LEDs (active LOW) ------------------------------------------
IO_LOC  "led_n[0]" 10;
IO_LOC  "led_n[1]" 11;
IO_LOC  "led_n[2]" 13;
IO_LOC  "led_n[3]" 14;
IO_LOC  "led_n[4]" 15;
IO_LOC  "led_n[5]" 16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---- HDMI port (emulated LVDS pairs) ---------------------------------------
// From YosysHQ/apicula examples/tangnano9k.cst (its dvi-example), which
// matches Sipeed's own hdmi example. Each pair is listed as _p and _n.
IO_LOC  "tmds_clk_p"  69;
IO_LOC  "tmds_clk_n"  68;
IO_LOC  "tmds_d_p[0]" 71;
IO_LOC  "tmds_d_n[0]" 70;
IO_LOC  "tmds_d_p[1]" 73;
IO_LOC  "tmds_d_n[1]" 72;
IO_LOC  "tmds_d_p[2]" 75;
IO_LOC  "tmds_d_n[2]" 74;
IO_PORT "tmds_clk_p"  IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_clk_n"  IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
